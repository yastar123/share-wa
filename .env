# Reference only. In Replit, add secrets in Tools > Secrets instead.
# DATABASE_URL is provisioned and injected by Replit; do not paste it here.
DATABASE_URL=

# Required to encrypt saved Baileys device credentials.
SESSION_SECRET=

# Initial administrator account, stored as Replit Secrets.
SHAREWA_ADMIN_EMAIL=admin@example.com
SHAREWA_ADMIN_PASSWORD=123admin123admin123admin123
