{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build --workspaces --if-present",
    "start": "tsx server.ts",
    "typecheck": "tsc --build",
    "lint": "tsc --build"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.0.1",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^6.0.7"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "js-yaml": "4.3.2"
  }
}
